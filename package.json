{
  "name": "@speleodb/map-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared SpeleoDB map domain algorithms",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "bun": "1.4.2"
  },
  "files": [
    "src",
    "assets",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./geometry-contract.json": "./src/geometry-contract.json",
    "./geometry-cases.json": "./src/geometry-cases.json"
  },
  "scripts": {
    "lock": "bun scripts/lock.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "bun build ./src/*.ts --target=browser --outdir=dist",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:lockfile": "bun scripts/check-lockfile.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "~6.0.3",
    "vitest": "5.0.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.1",
    "prettier": "3.9.9"
  },
  "dependencies": {
    "@types/geojson": "7946.0.16"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSpeleo/SpeleoDB-TS-MapCore.git"
  }
}
